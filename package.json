{
  "name": "mcpdet",
  "version": "0.0.0",
  "private": true,
  "description": "Detonate one local MCP server in a disposable container and report what each tool call did.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mcpdet": "dist/src/app/cli.js"
  },
  "exports": {
    "./model": {
      "types": "./dist/src/model.d.ts",
      "default": "./dist/src/model.js"
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "fixtures/detfix"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check": "tsc && node dist/checks/contract.js",
    "prepare": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "dns-packet": "^5.6.1",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
