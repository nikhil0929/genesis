          "value": "(\"runs\".\"status\" = 'running' and \"runs\".\"ended_at\" is null and \"runs\".\"verdict\" is null)\n    or (\"runs\".\"status\" <> 'running' and \"runs\".\"ended_at\" is not null and \"runs\".\"verdict\" is not null)"
